# ===========================================
# CONFIGURAÇÕES DO SISTEMA BANCÁRIO CORPORATIVO
# ===========================================
# Copie este arquivo para .env e configure os valores

# Senha para acesso administrativo ao sistema
ADMIN_PASSWORD=admin123

# Chave secreta para geração de tokens JWT
# Em produção, use uma chave forte e aleatória!
JWT_SECRET=sua_chave_secreta_muito_forte_aqui

# Ambiente Rails (development, test, production)
RAILS_ENV=development
